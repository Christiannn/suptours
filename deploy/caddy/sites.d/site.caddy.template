# Rendered by install-system-units.sh from deploy/environments/<env>.env.
# Placeholders: __PRIMARY_DOMAIN__ __API_HOST__ __APP_PORT__ __API_PORT__
#               __REDIRECT_HOSTS__ __BASIC_AUTH_USER__ __BASIC_AUTH_HASH__
#
# The three fenced blocks below are stripped when the environment does not want
# them, so one template serves both production (public, indexed, redirects) and
# staging (password, noindex, no redirects).

__PRIMARY_DOMAIN__ {
	encode zstd gzip

	# SvelteKit content-hashes everything under this path, so it can never go
	# stale and is always safe to cache hard. Biggest single bandwidth win as
	# traffic grows.
	@immutable path /_app/immutable/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# >>>NOINDEX_BLOCK
	# Without this, staging.suptur.dk would be crawled and would compete with
	# suptur.dk for the same content in search results.
	header X-Robots-Tag "noindex, nofollow, noarchive"
	# <<<NOINDEX_BLOCK

	# >>>AUTH_BLOCK
	# Staging sits behind one shared password. Requires Caddy >= 2.8, where the
	# directive was renamed from `basicauth` to `basic_auth`.
	#
	# /healthz is deliberately OUTSIDE the password: deploy.sh curls it over the
	# public internet at the end of every deploy to prove DNS and the
	# certificate are working, and the watchdog does the same every two minutes.
	# A 401 there would read as an outage.
	@protected not path /healthz
	basic_auth @protected {
		__BASIC_AUTH_USER__ __BASIC_AUTH_HASH__
	}
	# <<<AUTH_BLOCK

	reverse_proxy 127.0.0.1:__APP_PORT__

	log {
		output file /var/log/caddy/__PRIMARY_DOMAIN__.log {
			roll_size 20MiB
			roll_keep 3
			roll_keep_for 24h
		}
	}
}

# >>>REDIRECT_BLOCK
# Canonical host redirect. www included: ORIGIN is the apex, and adapter-node
# rejects POSTs whose Origin header does not match it.
# Rendered only for hosts that actually resolve here — see install-system-units.sh.
__REDIRECT_HOSTS__ {
	redir https://__PRIMARY_DOMAIN__{uri} permanent
}
# <<<REDIRECT_BLOCK

__API_HOST__ {
	encode zstd gzip

	# >>>NOINDEX_BLOCK
	header X-Robots-Tag "noindex, nofollow, noarchive"
	# <<<NOINDEX_BLOCK

	# Supabase Studio is served by the same gateway, so proxying the whole host
	# would put the dashboard on the public internet. Only the routes the
	# browser actually needs are forwarded; everything else — the Studio UI, the
	# pg-meta API — stays reachable only through an SSH tunnel.
	#
	# Note this host is NOT behind basic_auth even on staging: the browser calls
	# it directly with the anon key, and it has no way to send a password. Its
	# protection is the same as production's — RLS, plus only four route
	# prefixes being forwarded at all.
	@api path /rest/* /auth/* /storage/* /realtime/*
	handle @api {
		# Matches storage.file_size_limit = "50MiB" in supabase/config.toml.
		# Without it, uploads fail at the proxy rather than at the API.
		request_body {
			max_size 50MiB
		}
		reverse_proxy 127.0.0.1:__API_PORT__
	}

	handle {
		respond "Not found" 404
	}

	log {
		output file /var/log/caddy/__API_HOST__.log {
			roll_size 20MiB
			roll_keep 3
			roll_keep_for 24h
		}
	}
}
