[Unit]
Description=__APP_NAME__ housekeeping (logs, pruning, vacuum)
After=network-online.target docker.service

[Service]
Type=oneshot
User=__DEPLOY_USER__
ExecStart=__DEPLOY_DIR__/scripts/maintenance.sh
SyslogIdentifier=__APP_NAME__-maintenance
# Housekeeping must never compete with serving traffic.
Nice=10
IOSchedulingClass=idle
