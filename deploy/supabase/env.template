# ---------------------------------------------------------------------------
# Rendered by deploy/scripts/provision.sh to /srv/suptur/supabase/.env (0600).
#
# Secret values below are minted once on the first provision and then
# preserved verbatim on every later run. Do not rotate them casually:
# PUBLIC_SUPABASE_ANON_KEY is compiled into the browser bundle at build time,
# so changing JWT_SECRET invalidates every session AND breaks the deployed
# client until the app is rebuilt.
#
# Everything else is re-rendered from this template on each provision, so
# ordinary config changes are made here, in git, not by editing the server.
# ---------------------------------------------------------------------------

############ secrets — generated once, then preserved ############
POSTGRES_PASSWORD=@@GENERATED:POSTGRES_PASSWORD@@
JWT_SECRET=@@GENERATED:JWT_SECRET@@
ANON_KEY=@@GENERATED:ANON_KEY@@
SERVICE_ROLE_KEY=@@GENERATED:SERVICE_ROLE_KEY@@
SECRET_KEY_BASE=@@GENERATED:SECRET_KEY_BASE@@
VAULT_ENC_KEY=@@GENERATED:VAULT_ENC_KEY@@
PG_META_CRYPTO_KEY=@@GENERATED:PG_META_CRYPTO_KEY@@
REALTIME_DB_ENC_KEY=@@GENERATED:REALTIME_DB_ENC_KEY@@
DASHBOARD_USERNAME=@@GENERATED:DASHBOARD_USERNAME@@
DASHBOARD_PASSWORD=@@GENERATED:DASHBOARD_PASSWORD@@
S3_PROTOCOL_ACCESS_KEY_ID=@@GENERATED:S3_PROTOCOL_ACCESS_KEY_ID@@
S3_PROTOCOL_ACCESS_KEY_SECRET=@@GENERATED:S3_PROTOCOL_ACCESS_KEY_SECRET@@

############ database ############
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

############ networking ############
# Loopback-bound on purpose: Docker's iptables rules bypass ufw, so binding to
# 0.0.0.0 would publish the gateway to the internet regardless of the firewall.
# Caddy terminates TLS and is the only public entry point.
API_GW_HTTP_PORT=127.0.0.1:8000
KONG_HTTP_PORT=127.0.0.1:8000

SITE_URL=@@SITE_URL@@
API_EXTERNAL_URL=@@API_EXTERNAL_URL@@
SUPABASE_PUBLIC_URL=@@API_EXTERNAL_URL@@
ADDITIONAL_REDIRECT_URLS=@@ADDITIONAL_REDIRECT_URLS@@

############ PostgREST — mirrors supabase/config.toml [api] ############
PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_EXTRA_SEARCH_PATH=public,extensions
PGRST_DB_MAX_ROWS=1000

############ auth — mirrors supabase/config.toml [auth] ############
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
# config.toml has enable_confirmations = false, so signup must not wait on mail.
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

MFA_MAX_ENROLLED_FACTORS=10
MFA_TOTP_ENROLL_ENABLED=false
MFA_TOTP_VERIFY_ENABLED=false
MFA_PHONE_ENROLL_ENABLED=false
MFA_PHONE_VERIFY_ENABLED=false

MAILER_URLPATHS_CONFIRMATION=/auth/callback
MAILER_URLPATHS_INVITE=/auth/callback
MAILER_URLPATHS_RECOVERY=/auth/callback
MAILER_URLPATHS_EMAIL_CHANGE=/auth/callback

############ outbound mail ############
# Password reset and email change are dead without this. The same account is
# reused by the watchdog to send downtime alerts — see deploy/README.md.
SMTP_HOST=@@SMTP_HOST@@
SMTP_PORT=@@SMTP_PORT@@
SMTP_USER=@@SMTP_USER@@
SMTP_PASS=@@SMTP_PASS@@
SMTP_ADMIN_EMAIL=@@SMTP_ADMIN_EMAIL@@
SMTP_SENDER_NAME=@@SMTP_SENDER_NAME@@

############ social login ############
# Each provider must ALSO be listed in the app's own ENABLE_OAUTH var, which is
# what decides whether the button renders. Redirect URI to register with the
# provider is @@API_EXTERNAL_URL@@/auth/v1/callback
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
FACEBOOK_ENABLED=false
FACEBOOK_CLIENT_ID=
FACEBOOK_SECRET=
GITHUB_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_SECRET=
AZURE_ENABLED=false
AZURE_CLIENT_ID=
AZURE_SECRET=

############ storage ############
STORAGE_TENANT_ID=suptur
GLOBAL_S3_BUCKET=stub
IMGPROXY_AUTO_WEBP=true

############ studio ############
STUDIO_DEFAULT_ORGANIZATION=SUP Tours
STUDIO_DEFAULT_PROJECT=suptur
OPENAI_API_KEY=

############ unused, but referenced by the upstream compose file ############
# The pooler and edge runtime are parked behind the `unused` profile in
# docker-compose.override.yml. These keep compose from warning about
# unset variables while it parses their definitions.
FUNCTIONS_VERIFY_JWT=false
POOLER_TENANT_ID=suptur
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_DB_POOL_SIZE=5
POOLER_PROXY_PORT_TRANSACTION=127.0.0.1:6543
REGION=local
SAML_ENABLED=false
SAML_PRIVATE_KEY=
SAML_EXTERNAL_URL=
SAML_ALLOW_ENCRYPTED_ASSERTIONS=false
SAML_RATE_LIMIT_ASSERTION=15
SAML_RELAY_STATE_VALIDITY_PERIOD=300
SMS_PROVIDER=twilio
SMS_TWILIO_ACCOUNT_SID=
SMS_TWILIO_AUTH_TOKEN=
SMS_TWILIO_MESSAGE_SERVICE_SID=
SMS_MAX_FREQUENCY=5
SMS_OTP_EXP=6000
SMS_OTP_LENGTH=6
SMS_TEMPLATE=
SMS_TEST_OTP=

# New-style opaque API keys. Empty means the classic JWT anon/service keys
# above are used, which is what @supabase/supabase-js expects.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=
JWT_JWKS=
JWT_KEYS=
