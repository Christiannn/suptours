# Non-secret configuration for the STAGING environment.
#
# Staging is a full, independent copy of the stack on the same box: its own
# Supabase containers, its own Postgres, its own systemd units, its own release
# directory. Nothing is shared with production except Caddy and the kernel.
#
# Its database is DISPOSABLE — migrations plus supabase/seed-data.sql, never a
# copy of production. That is what keeps real customer data off a host sitting
# behind a shared password, and it means reset-staging-db.sh is always safe.
#
# Secrets:
#   /srv/suptur-staging/secrets.env      operator-supplied  0600
#   /srv/suptur-staging/supabase/.env    machine-generated  0600

APP_NAME=suptur-staging

PRIMARY_DOMAIN=staging.suptur.dk

# Nothing redirects to staging. Empty is handled: install-system-units.sh
# strips the whole redirect block rather than emitting `{ ... }`, which Caddy
# would reject.
REDIRECT_DOMAINS=""

API_HOST=api-staging.suptur.dk

# Second set of loopback ports; see PORTS.md.
APP_PORT=3001
API_PORT=8001
DB_PORT=5433
POOLER_PORT=6544

DEPLOY_ROOT=/srv/suptur-staging
GIT_REPO=https://github.com/Christiannn/suptours
GIT_BRANCH=staging
REMOTE_CLONE=~/suptur-staging

# Fewer releases: rollback here is a convenience, not a lifeline, and disk is
# shared with production's five.
RELEASES_TO_KEEP=3
BACKUP_RETENTION_DAYS=3

# Nothing on staging is worth backing up and nothing on it is worth being woken
# for. The watchdog still runs and still restarts a dead app — it just logs to
# the journal instead of emailing. See send_alert() in lib/common.sh.
ENABLE_BACKUPS=0
ENABLE_ALERTS=0

# Closed to the public and to crawlers. Without NOINDEX staging.suptur.dk would
# compete with suptur.dk for the same content in search results.
BASIC_AUTH=1
NOINDEX=1

DISK_WARN_PERCENT=85
HEALTH_RETRIES=10
HEALTH_RETRY_DELAY=3

# Staging exists to run unreleased code: any ref is fair game.
ALLOWED_REFS=""
