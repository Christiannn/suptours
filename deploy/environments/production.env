# Non-secret configuration for the PRODUCTION environment.
#
# Both environment files are checked into git and are identical on every branch.
# That is deliberate and load-bearing: if staging's values lived in a file that
# differed between branches, every develop -> staging -> main promotion would
# conflict on it. Scripts pick one at runtime via --env or .deploy-env instead.
#
# Secrets live in two other places, neither of them in git:
#   /srv/suptur/secrets.env      operator-supplied (SMTP, alert email)  0600
#   /srv/suptur/supabase/.env    machine-generated on first provision   0600

APP_NAME=suptur

# Primary domain. Everything else — the app's ORIGIN, the Supabase API host,
# GoTrue's allowed redirect list — is derived from it.
PRIMARY_DOMAIN=suptur.dk

# Hostnames that 301 to the primary. Space-separated.
# www is in here on purpose: ORIGIN is the apex, and SvelteKit rejects POSTs
# whose Origin header does not match it, so www must redirect rather than serve.
REDIRECT_DOMAINS="www.suptur.dk suptours.dk www.suptours.dk"

# Supabase's public hostname. The browser talks to it directly for auth,
# storage and realtime, so it cannot be loopback-only.
API_HOST=api.suptur.dk

# Loopback ports. One set per environment on this box; see PORTS.md.
APP_PORT=3000
API_PORT=8000
DB_PORT=5432
# Supavisor is dormant (profiles: [unused]) but the upstream compose file still
# references its port, so it needs a distinct value per environment anyway.
POOLER_PORT=6543

DEPLOY_ROOT=/srv/suptur
# Used for the initial clone on the VPS; deploy.sh then builds from that clone.
GIT_REPO=https://github.com/Christiannn/suptours
GIT_BRANCH=main
# Where that clone lives. Read by the PowerShell wrappers in local/.
REMOTE_CLONE=~/suptur

# Rollback depth and backup retention.
RELEASES_TO_KEEP=5
BACKUP_RETENTION_DAYS=14

# Production is the environment worth protecting: back up before every deploy,
# run the nightly backup timer, and email when the watchdog sees a state change.
ENABLE_BACKUPS=1
ENABLE_ALERTS=1

# Public site, indexed by search engines, no password in front of it.
BASIC_AUTH=0
NOINDEX=0

# Watchdog thresholds.
DISK_WARN_PERCENT=85
HEALTH_RETRIES=10
HEALTH_RETRY_DELAY=3

# Refs deploy.sh will accept for this environment, space-separated, globs
# allowed. Empty means anything. Production takes only the promoted branch and
# release tags, so "let me just try my feature branch on prod" needs the
# explicit --force-ref rather than a moment of inattention.
ALLOWED_REFS="main v*"
