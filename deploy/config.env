# Non-secret deployment configuration. Checked into git on purpose: this is the
# single place a value like the domain or the app's port is defined, so a
# change is reviewable rather than typed into a server by hand.
#
# Secrets live in two other places, neither of them in git:
#   /srv/suptur/secrets.env      operator-supplied (SMTP, alert email)  0600
#   /srv/suptur/supabase/.env    machine-generated on first provision   0600

APP_NAME=suptur

# Primary domain. Everything else — the app's ORIGIN, the Supabase API host,
# GoTrue's allowed redirect list — is derived from it.
PRIMARY_DOMAIN=suptur.dk

# Hostnames that 301 to the primary. Space-separated.
# www is in here on purpose: ORIGIN is the apex, and SvelteKit rejects POSTs
# whose Origin header does not match it, so www must redirect rather than serve.
REDIRECT_DOMAINS="www.suptur.dk suptours.dk www.suptours.dk"

# Supabase's public hostname. The browser talks to it directly for auth,
# storage and realtime, so it cannot be loopback-only.
API_HOST=api.suptur.dk

# Loopback port for the SvelteKit server. One per site on this box; see PORTS.md.
APP_PORT=3000

DEPLOY_ROOT=/srv/suptur
# Used for the initial clone on the VPS; deploy.sh then builds from that clone.
GIT_REPO=https://github.com/Christiannn/suptours
GIT_BRANCH=main

# Rollback depth and backup retention.
RELEASES_TO_KEEP=5
BACKUP_RETENTION_DAYS=14

# Watchdog thresholds.
DISK_WARN_PERCENT=85
HEALTH_RETRIES=10
HEALTH_RETRY_DELAY=3
