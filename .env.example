# ---------------------------------------------------------------------------
# Local development. Copy to `.env` — never commit the result.
# Get the URL and keys from `npx supabase status` after `npm run supabase:start`.
# The API port here must match `[api] port` in supabase/config.toml.
# ---------------------------------------------------------------------------
PUBLIC_SUPABASE_URL=http://127.0.0.1:54341
PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Required by `npm run reset` / `npm run seed:dev-user`. Local dev only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ---------------------------------------------------------------------------
# Optional. Read at runtime via $env/dynamic/private, so adding these to a
# deployed server needs a restart, not a rebuild. Leave blank and the features
# below simply report themselves as unconfigured.
# ---------------------------------------------------------------------------

# /admin/scraper. Without these the scraper UI stays disabled.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
BRAVE_SEARCH_API_KEY=
# GEMINI_MODEL=

# Social login. Comma-separated: google, facebook. Empty hides the buttons.
# Each provider listed here must also be configured in your Supabase project.
ENABLE_OAUTH=
